# Road Safety Pakistan — .gitignore

# Python
backend/venv/
venv/
__pycache__/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
*.egg-info/

# Django
backend/db.sqlite3
backend/db.sqlite3-journal
backend/media/
backend/staticfiles/
**/*.log

# ML Model
*.pt
*.onnx
*.weights
*.bin

# Environment variables — NEVER commit these
.env
.env.local
.env.production
.env.staging
.env.development
**/.env
**/.env.local
backend/.env
frontend/.env
frontend/.env.local

# Node
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.eslintcache

# OS files
.DS_Store
Thumbs.db
desktop.ini
._*
.Spotlight-V100
.Trashes

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Misc
*.zip
*.tar.gz
*.rar
.cache/