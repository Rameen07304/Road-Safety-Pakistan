# ============================================
# Road Safety Pakistan — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit your .env file to version control.

# Django Core
SECRET_KEY=change-me-to-a-real-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# JWT Token Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Django Admin URL path. This default is committed, so it gives no
# obscurity once the repository is public -- change it for a real deployment.
ADMIN_URL=admin-rsp-secure/

# Admin bootstrap user (used by `python manage.py createadmin`).
# ADMIN_PASSWORD is required -- createadmin refuses to run without it.
ADMIN_EMAIL=admin@roadsafety.pk
ADMIN_PASSWORD=change-me-in-production

# Path to the YOLOv8 model file relative to backend/
ML_MODEL_PATH=ml_models/best.pt

# Frontend origin, used to build password-reset links in emails
FRONTEND_URL=http://localhost:5173

# Refresh-token cookie. Set AUTH_COOKIE_SECURE=True behind HTTPS (prod forces it).
# Use AUTH_COOKIE_SAMESITE=None only if the frontend and API are on different sites.
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# Outgoing email for password resets (dev prints emails to the console instead)
DEFAULT_FROM_EMAIL=Road Safety Pakistan <no-reply@roadsafety.pk>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Login / register / password-reset attempts allowed per client IP
AUTH_THROTTLE_RATE=10/min

# --- Production only (core.settings.prod) ---
# Postgres connection string, e.g. from Neon. Unset = local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Proxy hops in front of Django, so throttles see the real client IP
# (2 for Vercel -> Render). Leave unset when nothing sits in front.
# NUM_PROXIES=2
