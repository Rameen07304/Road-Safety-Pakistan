# ============================================
# Road Safety Pakistan — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit your .env file to version control.

# Django Core
SECRET_KEY=change-me-to-a-real-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# JWT Token Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Django Admin URL path (keep secret in production)
ADMIN_URL=admin-rsp-secure/

# Admin bootstrap user (used by `python manage.py createadmin`)
ADMIN_EMAIL=admin@roadsafety.pk
ADMIN_PASSWORD=change-me-in-production

# Path to the YOLOv8 model file relative to backend/
ML_MODEL_PATH=ml_models/best.pt
